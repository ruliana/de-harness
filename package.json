{
  "name": "de-harness",
  "version": "0.1.0",
  "description": "A harness for decision models: agents whose model is used only to call tools",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser/index.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "HARNESS_CASSETTE=record NODE_USE_ENV_PROXY=1 vitest run",
    "example:tree": "NODE_USE_ENV_PROXY=1 tsx examples/tree/main.ts",
    "example:graph": "NODE_USE_ENV_PROXY=1 tsx examples/graph/main.ts",
    "example:rooms": "NODE_USE_ENV_PROXY=1 tsx examples/rooms/main.ts",
    "example:coffee": "NODE_USE_ENV_PROXY=1 tsx examples/coffee/main.ts",
    "example:pizza": "NODE_USE_ENV_PROXY=1 tsx examples/pizza/main.ts",
    "example:load-api": "NODE_USE_ENV_PROXY=1 tsx examples/load-api/main.ts",
    "example:tickets": "NODE_USE_ENV_PROXY=1 tsx examples/tickets/main.ts",
    "example:screen": "NODE_USE_ENV_PROXY=1 tsx examples/screen/main.ts",
    "example:screen:fixtures": "tsx examples/screen/render.ts",
    "example:wikipedia": "NODE_USE_ENV_PROXY=1 tsx examples/wikipedia/main.ts",
    "example:wikipedia:demo": "tsx examples/wikipedia/demo.ts",
    "example:storefront": "NODE_USE_ENV_PROXY=1 tsx examples/storefront/main.ts",
    "example:browser": "NODE_USE_ENV_PROXY=1 tsx examples/browser/main.ts",
    "example:storefront-browser": "NODE_USE_ENV_PROXY=1 tsx examples/storefront-browser/main.ts",
    "example:by-sight": "NODE_USE_ENV_PROXY=1 tsx examples/storefront-by-sight/main.ts",
    "example:shops": "NODE_USE_ENV_PROXY=1 tsx examples/shop-sweep/main.ts",
    "example:kanban": "NODE_USE_ENV_PROXY=1 tsx examples/kanban/main.ts",
    "example:kanban:demo": "tsx examples/kanban/demo.ts",
    "example:diagram": "NODE_USE_ENV_PROXY=1 tsx examples/diagram/main.ts",
    "example:diagram:demo": "tsx examples/diagram/demo.ts",
    "example:page-overlay": "NODE_USE_ENV_PROXY=1 tsx examples/page-overlay/main.ts",
    "example:probe": "NODE_USE_ENV_PROXY=1 tsx examples/storefront-by-sight/probe-main.ts"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "mermaid": "^12.3.0",
    "node-html-parser": "^9.0.7",
    "playwright": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "playwright": ">=1.49"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
